PORT=7860
# Optional: require this bearer key on /v1/* (leave empty to disable auth)
API_KEY=
# Include the server's own direct IP as an egress slot (true/false)
INCLUDE_DIRECT=true
# Path to the proxy list (one per line). PROXIES env (comma/newline) also works.
PROXIES_FILE=proxies.txt
# PROXIES=host:port:user:pass,host2:port2:user2:pass2

# ── tuning (defaults are conservative; raise as you add IPs) ──
# per-IP token bucket: burst capacity and 1-token-every-N-seconds refill
BUCKET_CAPACITY=4
BUCKET_REFILL_SEC=12
# park an IP this long after it returns kunlun_popup / status 1005
COOLDOWN_MS=60000
# re-harvest a slot's cookie once older than this
COOKIE_TTL_MS=600000
# how many IPs a single completion may hop across before giving up
MAX_RETRIES=6
